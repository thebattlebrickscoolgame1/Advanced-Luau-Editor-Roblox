                btn.MouseButton1Click:Connect(function()
                    playClick()
                    selectedTarget = desc
                    backdoorDetected = true
                    codeEditor.Text = string.format("-- Selected Target: %s\n-- Ready for execution", desc:GetFullName())
                    logEditor("Targeted: " + desc.Name, false)
                end)
            end
        end
    end
    listContainer.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(loadRemotes)
